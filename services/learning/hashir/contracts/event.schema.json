{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://showonce.invalid/contracts/hashir.ai.v1-proposed/event",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "hashir.ai.v1-proposed"
    },
    "type": {
      "enum": [
        "assessment",
        "error"
      ]
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "step_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "frame_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "latency_ms": {
      "type": "number",
      "minimum": 0
    },
    "assessment": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "hashir.ai.v1-proposed"
        },
        "submission_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "lesson_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "step_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "result": {
          "enum": [
            "pass",
            "retry",
            "uncertain"
          ]
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          },
          "maxItems": 30
        },
        "feedback": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "corrections": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          },
          "maxItems": 30
        },
        "requested_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          },
          "maxItems": 30
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "object",
            "properties": {
              "criterion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "pattern": "\\S"
              },
              "status": {
                "enum": [
                  "supported",
                  "violated",
                  "not_visible"
                ]
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "pattern": "\\S"
              }
            },
            "required": [
              "criterion",
              "status",
              "evidence"
            ],
            "additionalProperties": false
          }
        },
        "usage": {
          "type": "object",
          "properties": {
            "estimated_cost_usd": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "input_tokens": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "output_tokens": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 9223372036854775807
            }
          },
          "required": [
            "estimated_cost_usd",
            "input_tokens",
            "output_tokens"
          ],
          "additionalProperties": false
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "is_mock": {
          "type": "boolean"
        },
        "latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "safety_notice": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        }
      },
      "required": [
        "schema_version",
        "submission_id",
        "lesson_id",
        "step_id",
        "result",
        "observations",
        "feedback",
        "corrections",
        "requested_evidence",
        "criteria",
        "usage",
        "provider",
        "model",
        "is_mock",
        "latency_ms",
        "safety_notice"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "type",
    "session_id",
    "step_id",
    "frame_id",
    "captured_at",
    "latency_ms"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "type": {
          "const": "assessment"
        }
      },
      "required": [
        "assessment"
      ],
      "not": {
        "required": [
          "error"
        ]
      }
    },
    {
      "properties": {
        "type": {
          "const": "error"
        }
      },
      "required": [
        "error"
      ],
      "not": {
        "required": [
          "assessment"
        ]
      }
    }
  ]
}
