{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://showonce.invalid/contracts/hashir.ai.v1-proposed/frame-request",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "hashir.ai.v1-proposed"
    },
    "frame_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "mime_type": {
      "enum": [
        "image/png",
        "image/jpeg",
        "image/webp"
      ]
    },
    "image_base64": {
      "type": "string",
      "minLength": 1,
      "maxLength": 6990508
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "step_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": [
    "schema_version",
    "frame_id",
    "captured_at",
    "mime_type",
    "image_base64",
    "session_id",
    "step_id"
  ],
  "additionalProperties": false
}
