{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://showonce.invalid/contracts/hashir.ai.v1-proposed/lesson",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "hashir.ai.v1-proposed"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "source_url": {
      "const": "https://origami.me/cup/"
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000,
        "pattern": "\\S"
      },
      "maxItems": 30,
      "minItems": 1
    },
    "difficulty": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          },
          "position": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "instructions": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          },
          "expected_visual_result": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          },
          "assessment_criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "\\S"
            },
            "maxItems": 30,
            "minItems": 1
          },
          "visual_limits": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "\\S"
            },
            "maxItems": 30,
            "minItems": 1
          },
          "source_reference": {
            "type": "object",
            "properties": {
              "url": {
                "const": "https://origami.me/cup/"
              },
              "section": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "pattern": "\\S"
              },
              "text_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "url",
              "section",
              "text_sha256"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "position",
          "instructions",
          "expected_visual_result",
          "assessment_criteria",
          "visual_limits"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 100
    },
    "content_origin": {
      "enum": [
        "authored_fixture",
        "reviewed_html"
      ]
    },
    "practice_restrictions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000,
        "pattern": "\\S"
      },
      "maxItems": 30,
      "minItems": 1
    },
    "safety_notice": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    }
  },
  "required": [
    "schema_version",
    "id",
    "title",
    "category",
    "source_url",
    "materials",
    "difficulty",
    "steps",
    "content_origin",
    "practice_restrictions",
    "safety_notice"
  ],
  "additionalProperties": false
}
