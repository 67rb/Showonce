{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://showonce.invalid/contracts/hashir.ai.v1-proposed/vision-output",
  "type": "object",
  "properties": {
    "observations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000,
        "pattern": "\\S"
      },
      "maxItems": 30
    },
    "feedback": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000,
        "pattern": "\\S"
      },
      "maxItems": 30
    },
    "requested_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000,
        "pattern": "\\S"
      },
      "maxItems": 30
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "supported",
              "violated",
              "not_visible"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          }
        },
        "required": [
          "criterion",
          "status",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "usage": {
      "type": "object",
      "properties": {
        "estimated_cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "estimated_cost_usd",
        "input_tokens",
        "output_tokens"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "observations",
    "feedback",
    "corrections",
    "requested_evidence",
    "criteria",
    "usage"
  ],
  "additionalProperties": false
}
