{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "hashir.ai.v2-proposed"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "difficulty": {
      "type": [
        "string",
        "null"
      ]
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1200
      },
      "maxItems": 10
    },
    "source_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "content_origin": {
      "enum": [
        "fetched_html",
        "user_provided_text",
        "structured_text",
        "authored_example"
      ]
    },
    "safety_notice": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "practice_restrictions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1200
      },
      "maxItems": 10
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 18,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "position": {
            "type": "integer",
            "minimum": 1,
            "maximum": 18
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "instructions": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "expected_visual_result": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "assessment_criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1200
            },
            "maxItems": 10
          },
          "visual_limits": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1200
            },
            "maxItems": 10,
            "minItems": 1
          },
          "photo_assessable": {
            "type": "boolean"
          },
          "source_reference": {
            "type": "object",
            "properties": {
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "section": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              },
              "quote": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "text_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "url",
              "section",
              "quote"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "position",
          "title",
          "instructions",
          "expected_visual_result",
          "assessment_criteria",
          "visual_limits",
          "photo_assessable",
          "source_reference"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "photo_assessable": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "assessment_criteria": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "generation_usage": {
      "type": "object",
      "properties": {
        "estimated_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "estimated_cost_usd",
        "input_tokens",
        "output_tokens"
      ],
      "additionalProperties": false
    },
    "source_text": {
      "type": "string",
      "maxLength": 24000
    }
  },
  "required": [
    "schema_version",
    "id",
    "title",
    "category",
    "difficulty",
    "materials",
    "source_url",
    "content_origin",
    "safety_notice",
    "practice_restrictions",
    "steps"
  ],
  "additionalProperties": false
}
