# Server-side only. Export manually; nothing auto-loads .env files.
SHOWONCE_HASHIR_PORT=8011
# Only the explicit CLI assess-live command uses this key.
NVIDIA_API_KEY=replace-with-your-key
SHOWONCE_NVIDIA_MODEL=meta/llama-3.2-90b-vision-instruct
# Meta vision reads this only on the server; $5 local ledger in data/.
MODEL_API_KEY=replace-with-your-key
