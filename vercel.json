{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "out",
  "buildCommand": "npm run build:vercel",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/backend?__route=/api/:path*"
    },
    {
      "source": "/v1/:path*",
      "destination": "/api/backend?__route=/v1/:path*"
    },
    {
      "source": "/health",
      "destination": "/api/backend?__route=/health"
    },
    {
      "source": "/examples/:path*",
      "destination": "/api/backend?__route=/examples/:path*"
    }
  ]
}
